async function createSession(
    sessionId,
    userId = null,
    schoolId = null,
    role = null
) {
    await pool.query(
        `INSERT INTO sessions
        (id, user_id, school_id, role)
        VALUES ($1, $2, $3, $4)`,
        [
            sessionId,
            userId,
            schoolId,
            role
        ]
    );
}

async function hasSession(sessionId) {
    const result = await pool.query(
        "SELECT id FROM sessions WHERE id = $1",
        [sessionId]
    );

    return result.rowCount > 0;
}

async function getSession(sessionId) {
    const result = await pool.query(
        `SELECT
            id,
            user_id,
            school_id,
            role
         FROM sessions
         WHERE id = $1`,
        [sessionId]
    );

    return result.rows[0] || null;
}

async function requireSession(req) {

    const cookie =
        req.headers.cookie || "";

    const match =
        cookie.match(
            /(?:^|;\s*)session=([^;]+)/
        );

    if (!match) {
        return null;
    }

    const session =
        await getSession(match[1]);

    if (
        !session ||
        (!session.school_id && session.role !== "admin")
    ) {
        return null;
    }

async function requireRole(req, allowedRoles = []) {
    return session;
}
    const session =
        await requireSession(req);

    if (!session) {
        return null;
    }

    if (
        allowedRoles.length > 0 &&
        !allowedRoles.includes(session.role)
    ) {
        return null;
    }

    return session;
}


async function deleteSession(sessionId) {
    await pool.query(
        "DELETE FROM sessions WHERE id = $1",
        [sessionId]
    );
}


