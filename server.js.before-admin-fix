if (
    req.method === "POST" &&
    req.url === "/api/register"
) {
    return readBody(req, async (data) => {

        try {

            const username =
                String(data.username || "")
                    .trim()
                    .toLowerCase();

            const password =
                String(data.password || "");

            const schoolName =
                String(data.schoolName || "")
                    .trim();

            // Validation
            if (!username || !password || !schoolName) {
                return sendJSON(res, {
                    success: false,
                    message:
                        "Username, password and school name are required."
                }, 400);
            }

            if (username.length < 3) {
                return sendJSON(res, {
                    success: false,
                    message:
                        "Username must be at least 3 characters."
                }, 400);
            }

            if (password.length < 8) {
                return sendJSON(res, {
                    success: false,
                    message:
                        "Password must be at least 8 characters."
                }, 400);
            }

            // Check username
            const existingUser =
                await pool.query(
                    "SELECT id FROM users WHERE username = $1",
                    [username]
                );

            if (existingUser.rows.length > 0) {
                return sendJSON(res, {
                    success: false,
                    message:
                        "Username already exists."
                }, 409);
            }

            // Secure password hash
            const salt =
                crypto.randomBytes(16).toString("hex");

            const passwordHash =
                await new Promise((resolve, reject) => {

                    crypto.scrypt(
                        password,
                        salt,
                        64,
                        (error, derivedKey) => {

                            if (error) {
                                reject(error);
                                return;
                            }

                            resolve(
                                salt +
                                ":" +
                                derivedKey.toString("hex")
                            );
                        }
                    );

                });

            // Create school
            const schoolResult =
                await pool.query(
                    `INSERT INTO schools
                    (school_name)
                    VALUES ($1)
                    RETURNING id`,
                    [schoolName]
                );

            const schoolId =
                schoolResult.rows[0].id;

            // Create teacher account
            await pool.query(
                `INSERT INTO users
                (school_id, username, password_hash, role)
                VALUES ($1, $2, $3, $4)`,
                [
                    schoolId,
                    username,
                    passwordHash,
                    "teacher"
                ]
            );

            return sendJSON(res, {
                success: true,
                message:
                    "School account created successfully."
            });

        } catch (error) {

            console.error(
                "Registration error:",
                error
            );

            return sendJSON(res, {
                success: false,
                message:
                    "Registration failed."
            }, 500);

        }

    });
}


