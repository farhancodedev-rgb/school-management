                });

                return res.end(
                    JSON.stringify({
                        success: true,
                        role: "admin"
                    })
                );
            }


            // =========================
            // REGISTERED TEACHER LOGIN
            // =========================

            const result =
                await pool.query(
                    `SELECT
                        id,
                        school_id,
                        username,
                        password_hash,
                        role
                     FROM users
                     WHERE username = $1`,
                    [username]
                );

            if (result.rows.length === 0) {

                return sendJSON(res, {
                    success: false,
                    message:
                        "Invalid username or password."
                }, 401);

            }

            const user =
                result.rows[0];

            const parts =
                String(user.password_hash)
                    .split(":");

            if (parts.length !== 2) {

                return sendJSON(res, {
                    success: false,
                    message:
                        "Invalid account password format."
                }, 500);

            }

            const salt = parts[0];

            const storedHash =
                Buffer.from(parts[1], "hex");


            const validPassword =
                await new Promise((resolve, reject) => {

                    crypto.scrypt(
                        password,
                        salt,
                        64,
                        (error, derivedKey) => {

                            if (error) {
                                reject(error);
                                return;
                            }

                            resolve(
                                crypto.timingSafeEqual(
                                    storedHash,
                                    derivedKey
                                )
                            );

                        }
                    );

                });


            if (!validPassword) {

                return sendJSON(res, {
                    success: false,
                    message:
                        "Invalid username or password."
                }, 401);

            }


            // =========================
            // GET SCHOOL
            // =========================

            const schoolResult =
                await pool.query(
                    `SELECT
                        id,
                        school_name
                     FROM schools
                     WHERE id = $1`,
                    [user.school_id]
                );

            if (schoolResult.rows.length === 0) {

                return sendJSON(res, {
                    success: false,
                    message:
                        "School account not found."
                }, 404);

            }

            const school =
                schoolResult.rows[0];


            // =========================
            // CREATE SESSION
            // =========================

            const sessionId =
                crypto.randomBytes(32)
                    .toString("hex");

            await createSession(
                sessionId,
                user.id,
                user.school_id,
                user.role
            );


            res.writeHead(200, {

                "Content-Type":
                    "application/json; charset=utf-8",

                "Set-Cookie":
                    "session=" +
                    sessionId +
                    "; HttpOnly; Path=/; SameSite=Lax" +
                    (process.env.VERCEL
                        ? "; Secure"
                        : "")

            });


            return res.end(
                JSON.stringify({

                    success: true,

                    role: user.role,

                    schoolId:
                        school.id,

                    schoolName:
                        school.school_name

                })
            );


        } catch (error) {

            console.error(
                "Login error:",
                error
            );

            return sendJSON(res, {
                success: false,
                message:
                    "Login failed."
            }, 500);

        }

    });

}


